{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ccp-observe",
  "version": "1.0.0",
  "identifier": "com.ccpobserve.desktop",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "node scripts/bundle_proxy.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/proxy/proxy.py",
      "resources/proxy/ccp_launch.py",
      "resources/proxy/ccp",
      "resources/proxy/static",
      "resources/proxy/README.md",
      "resources/bin"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "category": "DeveloperTool",
    "shortDescription": "Local AI gateway observability for Claude Code / Codex",
    "longDescription": "Starts the ccp-observe proxy locally and embeds its observability panel. Configure any OpenAI-compatible or Anthropic-compatible upstream from the panel."
  }
}
